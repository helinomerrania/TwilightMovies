<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firefox's engine and the libraries it brings ask for Android 6.0 or 8.0 or newer: the app still installs on
         older boxes, and uses the box's own engine there (app/Engines never starts Firefox's before 8.0) -->
    <uses-sdk tools:overrideLibrary="org.mozilla.geckoview,
        androidx.core, androidx.core.ktx, androidx.annotation.experimental, androidx.arch.core, androidx.concurrent.futures,
        androidx.lifecycle, androidx.lifecycle.runtime, androidx.lifecycle.process, androidx.lifecycle.viewmodel,
        androidx.lifecycle.livedata, androidx.lifecycle.livedata.core, androidx.savedstate, androidx.startup,
        androidx.profileinstaller, androidx.tracing, androidx.versionedparcelable, androidx.window, androidx.datastore,
        androidx.media3.common, androidx.media3.container, androidx.media3.database, androidx.media3.datasource,
        androidx.media3.decoder, androidx.media3.exoplayer, androidx.media3.exoplayer.hls, androidx.media3.extractor,
        com.google.android.gms.fido, com.google.android.gms.base, com.google.android.gms.basement,
        com.google.android.gms.common, com.google.android.gms.tasks" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- whether the box is online (the error screen says which), and trying again when it is -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- new versions from GitHub (Android still asks on the TV before installing) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- runs on Android TV and TV boxes (in the TV launcher), and on tablets and phones -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- enableOnBackInvokedCallback="false": the remote's BACK key keeps coming to the app as a key -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|screenSize|smallestScreenSize|layoutDirection|density"
            android:windowSoftInputMode="stateHidden|adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android's answer when a new version is being installed -->
        <receiver
            android:name=".InstallResult"
            android:exported="false" />
    </application>
</manifest>
