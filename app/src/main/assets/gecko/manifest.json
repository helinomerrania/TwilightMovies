{
  "manifest_version": 2,
  "name": "Twilight Movies",
  "version": "1.0",
  "description": "The app inside Firefox's engine: its ad blocker, its scripts in the page, and the remote's arrows.",
  "browser_specific_settings": {
    "gecko": {
      "id": "movies@twilightcafe"
    }
  },
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "webNavigation",
    "nativeMessaging",
    "geckoViewAddons"
  ],
  "background": {
    "scripts": ["background.js", "study.js", "alone.js", "alone-play.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page.js", "player-steps.js", "player-servers.js", "player.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["arrows.js", "arrows-reach.js", "arrows-move.js", "arrows-frames.js", "arrows-keys.js"],
      "css": ["arrows.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["player-play.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
